//  Copy this file to Production.xcconfig and fill in real values.

// OAuth Configuration (ROT13 encrypted)
// Get these from your production OAuth app and encrypt with ROT13
OAUTH_CLIENT_ID = your-rot13-encrypted-oauth-client-id-here
OAUTH_SECRET_ID = your-rot13-encrypted-oauth-secret-id-here

// Google OAuth Configuration
// Get these from Google Cloud Console
GID_CLIENT_ID = your-google-client-id-here.apps.googleusercontent.com
GID_SERVER_CLIENT_ID = your-google-server-client-id-here.apps.googleusercontent.com

// API Keys and Secrets
BUGSNAG_API_KEY = your-bugsnag-api-key-here
FACEBOOK_APP_ID = your-facebook-app-id-here
FACEBOOK_CLIENT_TOKEN = your-facebook-client-token-here
TWITTER_APP_ID = your-twitter-app-id-here
TWITTER_APP_SECRET = your-twitter-app-secret-here
SDK_LICENSE_KEY = your-sdk-license-key-here

// Mobile API Token (ROT13 encrypted)
// Get this from your API configuration and encrypt with ROT13
MOBILE_TOKEN = your-rot13-encrypted-mobile-token-here

// Firebase/Google Services
// Get these from your Firebase project settings
FIREBASE_API_KEY = your-firebase-api-key-here
FIREBASE_PROJECT_ID = your-firebase-project-id-here
FIREBASE_STORAGE_BUCKET = your-firebase-storage-bucket-here
FIREBASE_GCM_SENDER_ID = your-firebase-gcm-sender-id-here
FIREBASE_GOOGLE_APP_ID = your-firebase-google-app-id-here
FIREBASE_DATABASE_URL = your-firebase-database-url-here

// URL Schemes for Deep Linking
// These are derived from the credentials above and used in Info.plist
// Extract the client ID part from GID_CLIENT_ID (remove .apps.googleusercontent.com)
GOOGLE_CLIENT_URL_SCHEME = com.googleusercontent.apps.your-google-client-id-here
GOOGLE_SERVER_URL_SCHEME = com.googleusercontent.apps.your-google-server-client-id-here
